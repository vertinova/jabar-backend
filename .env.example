# Salin ke .env lalu isi nilainya. File .env sendiri tidak masuk version control.

NODE_ENV=development
PORT=5000

DATABASE_URL="mysql://user:password@localhost:3306/forbasi_jabar"

JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==================== INTEGRASI FORBASI / SIMPASKOR ====================
FORBASI_API_URL=
FORBASI_API_KEY=
SIMPASKOR_API_URL=
SIMPASKOR_API_KEY=

# ==================== PEMBAYARAN (MIDTRANS) ====================
# Akun Midtrans ini dipakai bersama beberapa aplikasi, sementara dashboard-nya
# hanya menerima SATU notification URL. Karena itu setiap transaksi menimpa
# alamatnya lewat MIDTRANS_NOTIFICATION_URL agar callback vote (VOT-*) dan tiket
# (TKT-*) sampai ke backend ini.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=https://jabar.forbasi.or.id/api/payments/notification

# Masa berlaku QRIS checkout (menit).
VOTING_CHECKOUT_EXPIRY_MINUTES=15
TICKET_CHECKOUT_EXPIRY_MINUTES=15

# ==================== E-TICKETING ====================
# Penyapu pesanan menggantung. TTL sengaja lebih panjang dari masa berlaku QRIS
# supaya penyapu tidak pernah mendahului webhook Midtrans yang masih sah.
TICKET_SWEEP_INTERVAL_MINUTES=5
TICKET_PENDING_TTL_MINUTES=30

# ==================== PENGIRIMAN EMAIL (E-TICKET) ====================
# Tanpa ketiga nilai wajib di bawah, e-ticket TIDAK terkirim: tiket tetap terbit
# dan bisa dibuka lewat halaman kode pesanan, tapi pembeli tidak menerima email.
# Panel tiket menampilkan peringatan selama SMTP belum terhubung.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=FORBASI Jabar
SMTP_FROM_EMAIL=
